# Local-only service. Do not expose this listener to the public internet.
NEXORA_HOST=127.0.0.1
NEXORA_PORT=18765
NEXORA_DB_PATH=./data/nexora.sqlite
NEXORA_BROKER=none
NEXORA_MARKET_SOURCE=none
# Comma-separated read-only watchlist. XAUUSD remains the paper-trading symbol.
NEXORA_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
NEXORA_TWELVEDATA_API_KEY=
# Required only when NEXORA_MARKET_SOURCE=twelvedata. This is a paper-only fixed spread around the provider mid-price.
NEXORA_PAPER_SPREAD_PRICE=
# Optional explicit paper-account baseline. No equity is fabricated when blank.
NEXORA_PAPER_STARTING_EQUITY=
NEXORA_PAPER_CURRENCY=USD
NEXORA_CONTROL_TOKEN=
NEXORA_TELEGRAM_ENABLED=false
NEXORA_TELEGRAM_NOTIFICATIONS_ENABLED=false
NEXORA_TELEGRAM_DAILY_SUMMARY_UTC_HOUR=0
NEXORA_TELEGRAM_BOT_TOKEN=
NEXORA_TELEGRAM_ALLOWED_USER_IDS=
NEXORA_TELEGRAM_ALLOWED_CHAT_IDS=
PAPER_MODE=true
LIVE_TRADING_ENABLED=false
